[user]
	name = vas
	email = vasileiosC@users.noreply.github.com
	signingkey = ~/.ssh/devbox_signing
[init]
	defaultBranch = main
[core]
	excludesfile = ~/.gitignore
[color]
	ui = auto
[gpg]
	format = ssh
[gpg "ssh"]
        allowedSignersFile = ~/.ssh/allowed_signers
[commit]
	gpgsign = true
[tag]
	gpgsign = true
