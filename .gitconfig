[user]
	name = vas
	email = vasileiosC@users.noreply.github.com
	signingkey = ~/.ssh/devbox_signing
[init]
	defaultBranch = main
[core]
	excludesfile = ~/.gitignore
[color]
	ui = auto
[gpg]
	format = ssh
[commit]
	gpgsign = true
[tag]
	gpgsign = true
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential

